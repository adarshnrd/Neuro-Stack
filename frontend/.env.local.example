# Copy this to .env.local and fill in values

# ── Backend API ───────────────────────────────────────────────────────────────
# URL of the NestJS backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Secret used to sign JWT sessions — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-secure-random-string-min-32-chars

# Full URL of this Next.js app (required by next-auth in production)
NEXTAUTH_URL=http://localhost:3001

# ── Internal API URL (server-side only) ───────────────────────────────────────
# Used by NextAuth's CredentialsProvider to call the backend.
# In Docker Compose this is typically the service name, not localhost.
INTERNAL_API_URL=http://localhost:3000

# ── Azure / UI display ────────────────────────────────────────────────────────
# Azure DevOps organisation slug — used to build deep-links to PRs/repos.
# Must match the slug in the backend AZURE_ORG_URL (https://dev.azure.com/<slug>).
NEXT_PUBLIC_AZURE_ORG=your-azure-org-slug
# Display name shown in the sidebar
NEXT_PUBLIC_ORG_NAME=My Organization
