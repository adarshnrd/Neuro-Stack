# ──── Server ────
PORT=3000
NODE_ENV=development

# ──── LLM ────
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# ──── Multi-model providers (agent loop) ────
# Groq — fast open-weight inference (summarization, verdicts): https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# NVIDIA NIM — large reasoning models (planning, review): https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# NVIDIA Ultra — highest-parameter reasoning model; preferred for planning + review
NVIDIA_ULTRA_API_KEY=
NVIDIA_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ──── GitHub Auth (Option 1: PAT) ────
GITHUB_TOKEN=

# ──── GitHub Auth (Option 2: GitHub App) ────
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY_PATH=
# GITHUB_INSTALLATION_ID=

# ──── Repository ────
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main

# ──── Paths ────
WORKSPACE_PATH=./workspace
CONTEXT_PATH=./context

# ──── Folder Agent ────
# Base directory the web folder-picker (/folder) may browse within.
# Defaults to the OS home directory if unset.
FOLDER_AGENT_ROOT=

# ──── Session ────
SESSION_ACTIVE_WINDOW_HOURS=5
SESSION_RETENTION_DAYS=2
SESSION_AUTO_PURGE_DAYS=4

# ──── Context ────
CONTEXT_MAX_FILE_SIZE_KB=500
ARCHIVE_RETENTION_DAYS=30

# ──── Logging ────
LOG_LEVEL=info

# ──── Supabase (required) ────
SUPA_BASE_PROJECT_URL=
SUPA_BASE_DB_API_KEY=

# ──── Auth ────
# Secret for signing session tokens (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random per-boot secret is used and all logins reset on restart.
SESSION_SECRET=
