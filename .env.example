# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Must be a valid URI — used for CORS allow-list
FRONTEND_URL=http://localhost:5173

# Reporting timezone offset (minutes) for analytics day/month bucketing.
# Default 330 = IST (UTC+05:30). India has no DST so a fixed offset is correct.
ANALYTICS_TZ_OFFSET_MINUTES=330

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=dev_analytics

# ── JWT ──────────────────────────────────────────────────────────────────────
# Minimum 32 chars each
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret_32_chars
JWT_REFRESH_EXPIRATION=30d

# ── Encryption (REQUIRED) ────────────────────────────────────────────────────
# Minimum 16 chars. Used to encrypt secrets at rest — including each connected
# organization's Azure PAT and the stored webhook payloads. Keep it stable:
# changing it makes previously-encrypted PATs unreadable (re-enter them).
ENCRYPTION_KEY=change_me_to_a_long_random_secret

# ── Azure DevOps ─────────────────────────────────────────────────────────────
# Multiple organizations are now managed in-app (POST /organizations), each with
# its own PAT stored encrypted in the database. The two values below are the
# legacy single-org fallback still required by current config validation; they
# become optional in a later update (Chunk A2).
AZURE_ORG_URL=https://dev.azure.com/your-organisation
AZURE_PAT=your_personal_access_token_here
AZURE_WEBHOOK_SECRET=your_webhook_shared_secret_here

# ── AI / LangChain ───────────────────────────────────────────────────────────
# AI_MODEL_PROVIDER options: openai | anthropic | alibaba | custom
# All commit and pull-request analysis goes through ONE LLM client. To use the
# organization's LiteLLM proxy (recommended), keep provider=openai and set
# AI_CUSTOM_BASE_URL to the proxy base URL — ChatOpenAI then talks to LiteLLM
# instead of api.openai.com.
AI_MODEL_PROVIDER=openai
AI_MODEL_NAME=qwen3.6
AI_TEMPERATURE=0.2

# LiteLLM proxy base URL (OpenAI-compatible). Do NOT include "/chat/completions";
# the OpenAI SDK appends it. Example: http://192.168.10.13:4000
AI_CUSTOM_BASE_URL=http://your-litellm-host:4000

# LiteLLM virtual key (sent as the Bearer token). Falls back to a real OpenAI key
# only when AI_CUSTOM_BASE_URL is unset.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Only when AI_MODEL_PROVIDER=alibaba (native Dashscope, bypasses LiteLLM)
# ALIBABA_API_KEY=your_alibaba_key_here

# Verbose AI tracing — logs exact AI prompt inputs, raw responses, and commit
# input data. Use for validation/debugging; leave unset (off) in production.
# AI_DEBUG=true
