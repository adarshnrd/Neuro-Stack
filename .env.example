# ──── Server ────
PORT=3000
# Interface to bind. Use 0.0.0.0 in Docker / on a server; localhost for local dev.
HOST=localhost
# development | production | test. Production enables JSON logs, Secure cookies,
# a mandatory SESSION_SECRET, and closed sign-up by default.
NODE_ENV=development
# Set when running behind a reverse proxy / load balancer so rate limiting and
# Secure cookies see the real client: true, a hop count (e.g. 1), or a subnet list.
TRUST_PROXY=

# ──── LLM ────
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
# Per-call timeout before an LLM request is retried / failed over (ms)
LLM_TIMEOUT_MS=120000

# ──── Multi-model providers (agent loop) ────
# Groq — fast open-weight inference (summarization, verdicts): https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# NVIDIA NIM — large reasoning models (planning, review): https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# NVIDIA Ultra — highest-parameter reasoning model; preferred for planning + review
NVIDIA_ULTRA_API_KEY=
NVIDIA_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ──── GitHub Auth (Option 1: PAT) ────
GITHUB_TOKEN=

# ──── GitHub Auth (Option 2: GitHub App) ────
# Provide the private key inline (with \n escapes) OR as a path to the .pem file.
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=
# GITHUB_PRIVATE_KEY_PATH=
# GITHUB_INSTALLATION_ID=

# ──── Repository ────
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main

# ──── Paths ────
WORKSPACE_PATH=./workspace
CONTEXT_PATH=./context

# ──── Folder Agent ────
# Base directory the folder agent (web UI) may browse and run in. Runs outside
# it are rejected. Defaults to the OS home directory if unset — set it explicitly
# in production. The folder agent is admin-only.
FOLDER_AGENT_ROOT=

# ──── Logging ────
# error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info
LOG_DIR=./logs

# ──── Supabase (required) ────
SUPA_BASE_PROJECT_URL=
# Use the secret (service_role) key — the backend relies on it to bypass RLS.
SUPA_BASE_DB_API_KEY=

# ──── Auth ────
# Secret for signing session tokens (min 32 chars). REQUIRED when NODE_ENV=production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset outside production, a random per-boot secret is used and all logins reset on restart.
SESSION_SECRET=
# Allow anyone to create an account. The first account (the admin) can always
# register. Defaults to true in development and false in production.
ALLOW_REGISTRATION=
