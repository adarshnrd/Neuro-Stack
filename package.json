{
  "name": "project-neurostack",
  "version": "1.0.0",
  "description": "AI-Powered Git Workflow Assistant built with Node.js, LangChain, LangGraph, and Google Gemini.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:providers": "tsx scripts/smokeProviders.ts",
    "eval": "tsx evals/runEvals.ts",
    "folder": "tsx scripts/agentFolder.ts",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/google": "^0.1.9",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.2.6",
    "@langchain/openai": "^1.5.5",
    "@octokit/auth-app": "^7.1.4",
    "@octokit/rest": "^21.0.2",
    "@supabase/supabase-js": "^2.104.1",
    "bcrypt": "^6.0.0",
    "diff": "^9.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-handlebars": "^8.0.1",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.6",
    "simple-git": "^3.27.0",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.10",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
